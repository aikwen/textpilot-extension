{
  "manifest_version": 3,
  "name": "TextPilot",
  "version": "0.1.0",
  "description": "A lightweight browser input snippet panel.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}